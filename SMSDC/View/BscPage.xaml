<Page
    x:Class="SMSDC.View.BscPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SMSDC.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemChromeGrayColor}"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="Header"
                Grid.Row="0"
                Grid.ColumnSpan="4"
                Height="200"
                Margin="4"
                VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>
                <TextBlock
                    Height="100"
                    HorizontalAlignment="Center"
                    FontSize="50"
                    Text="Shree Malkhan Singh Mahavidhyalaya Jahangirpur Hathras" />
                <Rectangle
                    Grid.Row="1"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Fill="Red" />

            </Grid>

            <Grid Grid.Row="1" Grid.ColumnSpan="4">
                <ListView>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Grid>
    </Grid>

</Page>
