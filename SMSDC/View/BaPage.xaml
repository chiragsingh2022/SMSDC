<Page
    x:Class="SMSDC.View.BaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SMSDC.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Page"
    Background="LightGray"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="Header"
                Grid.Row="0"
                Grid.ColumnSpan="4"
                Height="200"
                Margin="4"
                VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>
                <TextBlock
                    Height="100"
                    HorizontalAlignment="Center"
                    FontSize="50"
                    Text="Shree Malkhan Singh Mahavidhyalaya Jahangirpur Hathras" />
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="Button_Click"
                    Content="Add Student" />
                <Rectangle
                    Grid.Row="1"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Fill="Red" />

            </Grid>

            <Grid
                Grid.Row="1"
                Grid.RowSpan="5"
                Grid.ColumnSpan="2">
                <ListView
                    Margin="4"
                    IsRightTapEnabled="True"
                    ItemsSource="{Binding ViewModel.BaPageData, ElementName=Page, Mode=TwoWay}"
                    RightTapped="ListView_RightTapped"
                    SelectedValue="{Binding ViewModel.SelectedItem, ElementName=Page, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="150">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding RollNumber}" />
                                <TextBlock Grid.Row="1">
                                    <Run Text="{Binding FirstName}" />
                                    <Run Text="{Binding MiddleName}" />
                                    <Run Text="{Binding LastName}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

            </Grid>
        </Grid>
    </Grid>
</Page>
