<Page
    x:Class="SMSDC.View.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SMSDC.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="LightGray"
    mc:Ignorable="d">

    <Grid>
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!--#region Header-->
            <Grid
                x:Name="Header"
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Height="200"
                Margin="4"
                VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>
                <TextBlock
                    Height="100"
                    HorizontalAlignment="Center"
                    FontSize="50"
                    Text="Shree Malkhan Singh Mahavidhyalaya Jahangirpur Hathras" />
                <Rectangle
                    Grid.Row="1"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Fill="Red" />

            </Grid>
            <!--#endregion-->
            <!--#region LeftPane-->
            <Grid
                x:Name="LeftPane"
                Grid.Row="1"
                Width="450"
                Margin="4"
                HorizontalAlignment="Left"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <RelativePanel Margin="2">
                    <Button
                        Width="220"
                        Height="110"
                        Margin="2"
                        Content="B.Sc"
                        RelativePanel.Above="EditBtn"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        x:Name="EditBtn"
                        Width="220"
                        Height="110"
                        Margin="2"
                        Content="BA"
                        RelativePanel.Above="DeleteBtn"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        x:Name="DeleteBtn"
                        Width="220"
                        Height="110"
                        Margin="2"
                        Content="Delete Student"
                        RelativePanel.AlignBottomWithPanel="True"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        x:Name="GetBtn"
                        Width="220"
                        Height="110"
                        Margin="2"
                        Content="Get Student"
                        RelativePanel.Above="Details"
                        RelativePanel.RightOf="DeleteBtn"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        x:Name="Details"
                        Width="220"
                        Height="110"
                        Margin="2"
                        Content="Details"
                        RelativePanel.Above="LogoutBtn"
                        RelativePanel.RightOf="EditBtn"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        x:Name="LogoutBtn"
                        Width="220"
                        Height="110"
                        Margin="2"
                        Content="Logout"
                        RelativePanel.AlignBottomWithPanel="True"
                        RelativePanel.RightOf="DeleteBtn"
                        Style="{ThemeResource AccentButtonStyle}" />

                </RelativePanel>
            </Grid>
            <!--#endregion-->
            <!--#region RightPart-->
            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="4"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <CalendarView
                    Width="1500"
                    Height="776"
                    VerticalAlignment="Top" />
            </Grid>
            <!--#endregion-->
        </Grid>
    </Grid>

</Page>
