<ContentDialog
    x:Class="SMSDC.Dialog.AddBaStudent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="CCDialog"
    Title="Add Student"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Cancel"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    SecondaryButtonText="Save"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMinWidth">1500</x:Double>
            <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">800</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">2000</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="110" />
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />

        </Style>
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.SecondaryButtonStyle>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="110" />
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />

        </Style>
    </ContentDialog.SecondaryButtonStyle>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBox Header="Roll Number" Text="{Binding AddNewBaStudents.RollNumber, ElementName=CCDialog, Mode=TwoWay}" />
        <TextBox
            Grid.Column="1"
            Header="First Name"
            Text="{Binding AddNewBaStudents.FirstName, ElementName=CCDialog, Mode=TwoWay}" />
        <TextBox
            Grid.Column="2"
            Header="Middle Name"
            Text="{Binding AddNewBaStudents.MiddleName, ElementName=CCDialog, Mode=TwoWay}" />
        <TextBox
            Grid.Row="0"
            Grid.Column="3"
            Header="Last Name"
            Text="{Binding AddNewBaStudents.LastName, ElementName=CCDialog, Mode=TwoWay}" />

    </Grid>
</ContentDialog>
